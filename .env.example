# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# --- App ---
APP_ENV=development
HTTP_PORT=8080
REQUEST_TIMEOUT_SECONDS=10

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=foodtracker
POSTGRES_PASSWORD=foodtracker
POSTGRES_DB=foodtracker
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MAX_IDLE_CONNS=5

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- WhatsApp Cloud API (added in Phase 2) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# --- LLM provider (added in Phase 3) ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Nutrition provider (added in Phase 4) ---
NUTRITION_PROVIDER=usda
NUTRITION_API_KEY=